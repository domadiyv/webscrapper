# SMTP credentials for the notification email (all four are required;
# if any is missing the run still succeeds and email is simply skipped).
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
# Gmail requires an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com

# Optional SMTP settings
#SMTP_PORT=587
#SMTP_TLS=true
#EMAIL_FROM=you@gmail.com

# Optional scraper tuning
#TARGET_AGE=8
#MAX_PAGES=50
# Registration states to report on: open,upcoming,waitlist,ended,offline,unknown
# Default is "open,upcoming". Use "upcoming" alone for future registrations only.
#REGISTRATION_STATES=open,upcoming
